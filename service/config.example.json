{
  "_comment": "Copy this file to config.json in the same directory as AdminExecMCP.exe",
  "port": 12380,
  "bind_address": "127.0.0.1",
  "listen_backlog": 16,
  "max_concurrent_clients": 16,
  "ssl_verify": true,
  "log_level": "info",
  "approval": {
    "enabled": false,
    "type": "telegram",
    "telegram": {
      "bot_token": "YOUR_BOT_TOKEN_HERE",
      "chat_id": "YOUR_CHAT_ID_HERE",
      "proxy": "",
      "proxy_username": "",
      "proxy_password": "",
      "timeout_seconds": 300,
      "poll_interval_ms": 2000
    },
    "qq": {
      "app_id": "YOUR_QQ_BOT_APP_ID",
      "app_secret": "YOUR_QQ_BOT_APP_SECRET",
      "user_openid": "",
      "timeout_seconds": 300
    }
  }
}
